# Copy this file to .env for local development (never commit the real .env).
# In production, set these as environment variables in your hosting provider's
# dashboard instead — do not put your real key in a file that gets deployed.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Comma-separated list of frontend origins allowed to call this API.
# Use * only for local testing — set this to your real deployed frontend
# URL before going live, e.g. https://major-fit.vercel.app
ALLOWED_ORIGINS=*

# How many /api/interest-signals calls one IP can make per hour.
RATE_LIMIT=30/hour

# Where the usage-tracking SQLite file lives. Default is fine for most setups.
DB_PATH=usage.db

# Secret token that protects /api/admin/stats and /api/admin/dashboard.
# Pick any long random string — this is what only you should know.
ADMIN_TOKEN=choose-a-long-random-string-here
